# Local development only. Never commit real secrets.
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Neon PostgreSQL (migration target)
DATABASE_URL=
PGSSLMODE=require
PG_POOL_MAX=5

# Cloudflare R2 (migration target)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mavhola-parish-files
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# Email (existing Resend configuration)
RESEND_API_KEY=
MAIL_FROM=ELCSA Mavhola Parish <noreply@send.mavholaparish.co.za>
PUBLIC_BASE_URL=https://mavholaparish.co.za
